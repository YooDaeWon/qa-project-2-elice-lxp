# ============================================================
# 고정 환경값 - 이미 확인된 QA 환경
# ============================================================
API_BASE_URL=https://dev-qatrack-api.dev.elicer.io
CLASSROOM_API_BASE_URL=https://dev-qatrack-classroom-api.dev.elicer.io
DASHBOARD_API_BASE_URL=https://dev-qatrack-dashboard-api.dev.elicer.io
ACCOUNT_API_BASE_URL=https://dev-qatrack-account-api.dev.elicer.io

AUTH_HEADER=Authorization
AUTH_PREFIX="Bearer "
AUTH_COOKIE_NAME=

ORG=academy
ORG_CANDIDATES=academy,qatrack
CLASSROOM_ID=afb67bc3-862e-45c7-a2cf-7fef53c032ec
COURSE_ID=734
LOCATOR_TYPE=0

DATE_START=2026-08-01T00:00:00+09:00
DATE_END=2026-08-31T23:59:59+09:00
SCHEDULE_COUNT=20

# 학습자 계정
ST_ID=
ST_PW=

# 교육자 계정
TC_ID=
TC_PW=

# 더미 계정 써주시면 됩니다.
DUMMY_ID=
DUMMY_PW=

# 더미 계정 2 / API TC 60 61 67 전용 계정
DUMMY_2_ID=
DUMMY_2_PW=


# ID-30 전용 계정 (권한 부여/회수 반복 검증용 - 다른 테스트와 공유하지 말 것)
SEC_WITHDRAW_ID=(디스코드 전달 내용 확인)
SEC_WITHDRAW_PW=(디스코드 전달 내용 확인)


# 기본 학습자 토큰
STSESSION_KEY=

# 교육자 토큰
TCSESSION_KEY=

# STSESSION_A_KEY은 비워두면 STSESSION_KEY을 자동 사용
STSESSION_A_KEY=

# 더미 학습자 토큰
STSESSION_B_KEY=


# 학생 ID (고정값)
OTHER_STUDENT_ID=177
STUDENT_ID=150

# 로그인 예외 케이스
VALID_EMAIL= # 유효한 계정 넣으시면 됩니다.
VALID_PASSWORD= # 유효한 계정 넣으시면 됩니다.

INVALID_EMAIL=test@test123.com
INVALID_PASSWORD=testpw1?

# 유효한 계정 정보에 띄어쓰기 추가 테스트 / "" 넣어주셔야 합니다.
EMAIL_WITH_SPACES= # 예시 " test@korea.com "
PASSWORD_WITH_SPACE= # 예시 "teatpw1? "


# ============================================================
# 아래 ID들은 AUTO_DISCOVER=true이면 자동 조회/생성
# 수동으로 특정 데이터를 쓰고 싶을 때만 값을 입력하세요.
# ============================================================
LECTURE_ID=
EDIT_LECTURE_ID=
DELETE_LECTURE_ID=
BLOCK_DELETE_LECTURE_ID=
BLOCK_EDIT_LECTURE_ID=

MATERIAL_NOTE_ID=
DELETE_LECTURE_PAGE_ID=
BLOCK_MATERIAL_NOTE_ID=
BLOCK_DELETE_LECTURE_PAGE_ID=

SCHEDULE_ID=
DELETE_SCHEDULE_ID=
BLOCK_DELETE_SCHEDULE_ID=
BLOCK_UPDATE_SCHEDULE_ID=
LECTUREROOM_ID=

BOARD_ID=
NOTICE_BOARD_ID=
BOARD_ARTICLE_ID=
OWN_ARTICLE_ID=
OTHER_ARTICLE_ID=
EDUCATOR_DELETE_ARTICLE_ID=
SECRET_ARTICLE_ID=

# ============================================================
# 자동 데이터 준비
# ============================================================
AUTO_DISCOVER=true
AUTO_RESOLVE_ORG=true

# 테스트가 생성한 자동 준비용 데이터는 세션 종료 시 가능한 범위에서 정리
AUTO_SETUP_TEST_DATA=true

# 개별 TC에서 생성한 데이터의 자동 삭제 여부
AUTO_CLEANUP=true

# TC68 정책
EMPTY_CONTENT_POLICY=reject
